#!/bin/bash
# Configure /etc/hosts to redirect localhost and facebook.com

# 1. Update localhost resolution
# We use a regex to ensure we only replace the specific 127.0.0.1 localhost entry
sed -i 's/^127.0.0.1[[:space:]]\+localhost/127.0.0.2\tlocalhost/' /etc/hosts

# 2. Add or update facebook.com resolution
if grep -q "facebook.com" /etc/hosts; then
    sed -i 's/.*facebook.com/8.8.8.8 facebook.com/' /etc/hosts
else
    echo "8.8.8.8 facebook.com" >> /etc/hosts
fi