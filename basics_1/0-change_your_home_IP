#!/usr/bin/env bash
set -euo pipefail

HOSTS_FILE="/etc/hosts"
TMP_FILE="$(mktemp)"

cleanup() {
  rm -f "$TMP_FILE"
}
trap cleanup EXIT

if [ "$(id -u)" -ne 0 ]; then
  echo "Please run as root" >&2
  exit 1
fi

sed -E 's/^127\.0\.0\.1(\s+.*\blocalhost\b.*)/127.0.0.2\1/' "$HOSTS_FILE" | grep -Ev '\bfacebook\.com\b' > "$TMP_FILE"

if ! grep -Eq '^127\.0\.0\.2(\s+.*\blocalhost\b.*)?' "$TMP_FILE"; then
  printf '127.0.0.2 localhost\n' >> "$TMP_FILE"
fi

printf '8.8.8.8 facebook.com\n' >> "$TMP_FILE"

cp "$TMP_FILE" "$HOSTS_FILE"
