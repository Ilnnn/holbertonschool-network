#!/bin/bash
# This script configures the host resolution by modifying /etc/hosts

# 1. Update localhost resolution from 127.0.0.1 to 127.0.0.2
# The 'sed' command searches for the pattern and replaces it
sudo sed -i 's/127.0.0.1\tlocalhost/127.0.0.2\tlocalhost/' /etc/hosts

# 2. Add facebook.com resolution to 8.8.8.8
# Append the mapping entry to the end of the /etc/hosts file
echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts