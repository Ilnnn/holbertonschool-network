#!/bin/bash
# Configures the Ubuntu server so localhost resolves to 127.0.0.2
# and facebook.com resolves to 8.8.8.8

# 1. Safely replace 127.0.0.1 with 127.0.0.2 ONLY for localhost
sudo sed -i 's/127.0.0.1[[:space:]]\+localhost/127.0.0.2\tlocalhost/' /etc/hosts

# 2. Update or append facebook.com resolution to 8.8.8.8
if grep -q "facebook.com" /etc/hosts; then
    # Use sed to update the existing entry
    sudo sed -i 's/.*facebook.com/8.8.8.8 facebook.com/' /etc/hosts
else
    # Use tee to append with sudo privileges
    echo "8.8.8.8 facebook.com" | sudo tee -a /etc/hosts
fi